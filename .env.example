# Frontend (Vite) build-time vars — required at `docker build` time and at
# Lovable build time (set these in Lovable → Project Settings → Build Secrets
# to point the preview/published lovable.app at self-hosted Supabase).
VITE_SUPABASE_URL=https://supabase.curemedkw.com
VITE_SUPABASE_PUBLISHABLE_KEY=your-self-hosted-anon-key
VITE_SUPABASE_PROJECT_ID=self-hosted-curemed

# Dokploy-only runtime overrides — read by docker/start-nginx.sh and written
# into /usr/share/nginx/html/config.js on container start. Allows switching
# backend without rebuilding the image.
RUNTIME_SUPABASE_URL=https://supabase.curemedkw.com
RUNTIME_SUPABASE_ANON_KEY=your-self-hosted-anon-key

# Server-side secrets (SERVICE_ROLE_KEY, JWT_SECRET, POSTGRES_PASSWORD,
# PICSART_API_KEY, OPENROUTER_API_KEY, FIRECRAWL_API_KEY, LOVABLE_API_KEY,
# SMTP_*, GOOGLE_CLIENT_SECRET, etc.) DO NOT belong here. They live only on
# the self-hosted Supabase stack — see SELF_HOSTED.md sections C and H.
